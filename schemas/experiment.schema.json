{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armproof.dev/schemas/experiment.schema.json",
  "title": "ArmProof Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "hypothesis",
    "causal_scope",
    "treatments",
    "workload_ref",
    "primary_metric",
    "acceptance",
    "environment_ref",
    "repetitions",
    "maximum_runtime_minutes",
    "maximum_cost_usd",
    "evidence_path"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "experiment_id": { "type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{3}$" },
    "status": {
      "enum": ["preregistered", "running", "passed", "failed", "inconclusive", "aborted", "import_pending", "imported"]
    },
    "hypothesis": { "type": "string", "minLength": 20 },
    "causal_scope": {
      "enum": ["artifact", "arm_acceleration", "whole_deployment", "cloud_capacity", "overhead", "reproduction"]
    },
    "treatments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact_ref", "runtime_ref", "command_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "artifact_ref": { "type": "string", "minLength": 1 },
          "runtime_ref": { "type": "string", "minLength": 1 },
          "command_ref": { "type": "string", "minLength": 1 },
          "environment_overrides": { "type": "object" }
        }
      }
    },
    "workload_ref": { "type": "string", "minLength": 1 },
    "quality_ref": { "type": "string" },
    "primary_metric": { "type": "string", "minLength": 1 },
    "secondary_metrics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "acceptance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["number", "integer", "string", "boolean"] }
    },
    "environment_ref": { "type": "string", "minLength": 1 },
    "repetitions": { "type": "integer", "minimum": 3 },
    "randomization": { "type": "string" },
    "warmup_policy": { "type": "string" },
    "profiler_ref": { "type": "string" },
    "maximum_runtime_minutes": { "type": "integer", "minimum": 1 },
    "maximum_cost_usd": { "type": "number", "minimum": 0, "maximum": 15 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "decision": { "type": "string" },
    "evidence_path": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
