{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIdentityPricingQuotaAndCanonicalAmi",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "pricing:GetProducts",
        "servicequotas:GetServiceQuota",
        "ssm:GetParameter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeEc2ForLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeSnapshots",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LaunchSupportingResourcesInApprovedRegion",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/ami-*",
        "arn:aws:ec2:us-east-1::snapshot/*",
        "arn:aws:ec2:us-east-1:758225284214:network-interface/*",
        "arn:aws:ec2:us-east-1:758225284214:security-group/*",
        "arn:aws:ec2:us-east-1:758225284214:subnet/*",
        "arn:aws:ec2:us-east-1:758225284214:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LaunchOnlyApprovedGravitonInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:758225284214:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": ["KleidiScope", "ArmProof"],
          "ec2:InstanceType": ["c8g.2xlarge", "c8g.4xlarge"]
        }
      }
    },
    {
      "Sid": "TagApprovedProjectResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": ["KleidiScope", "ArmProof"]
        }
      }
    },
    {
      "Sid": "TerminateOnlyApprovedProjectInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:us-east-1:758225284214:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": ["KleidiScope", "ArmProof"]
        }
      }
    },
    {
      "Sid": "ListBucketsForLifecycleInventory",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyApprovedProjectBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:ListBucket",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::kleidiscope-758225284214-*",
        "arn:aws:s3:::armproof-758225284214-*"
      ]
    },
    {
      "Sid": "ManageOnlyApprovedProjectObjects",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::kleidiscope-758225284214-*/*",
        "arn:aws:s3:::armproof-758225284214-*/*"
      ]
    }
  ]
}
