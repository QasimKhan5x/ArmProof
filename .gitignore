.DS_Store
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
node_modules/
test-results/
models/
*.gguf
*.safetensors
/runtime-checkpoints.tar.gz
# Keep manifests, summaries and claim ledgers versioned. Put external or
# license-restricted payloads under a run's large/ directory and reference
# their immutable URL and checksum from the manifest.
ops/evidence/**/large/
ops/experiments/*.local.jsonl
performix/
*.log
!ops/evidence/**/*.log
# AWS runners return the immutable evidence archive separately. These are
# local inspection and launch-bundle copies, not additional evidence.
ops/evidence/**/extracted/
ops/evidence/**/project.tar.gz
