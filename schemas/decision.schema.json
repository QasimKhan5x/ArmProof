{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armproof.dev/schemas/decision.schema.json",
  "title": "ArmProof Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passed", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "passed": {"type": "boolean"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "reason_code", "observed", "threshold"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
          "reason_code": {"type": "string", "minLength": 1},
          "observed": {"type": ["number", "null"]},
          "threshold": {"type": "number"}
        }
      }
    }
  }
}
