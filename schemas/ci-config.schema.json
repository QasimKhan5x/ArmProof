{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armproof.dev/schemas/ci-config.schema.json",
  "title": "ArmProof CI Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "root", "checksums", "workload_manifest", "reproduction"],
      "properties": {
        "adapter": {"const": "kleidiai-capacity-v1"},
        "root": {"type": "string", "minLength": 1},
        "checksums": {"type": "string", "minLength": 1},
        "workload_manifest": {"type": "string", "minLength": 1},
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "checksums"],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "checksums": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "deployment_summary": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1}
  }
}
