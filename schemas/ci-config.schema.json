{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armproof.dev/schemas/ci-config.schema.json",
  "title": "ArmProof CI Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract": {"type": "string", "minLength": 1},
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "root", "checksums", "workload_manifest", "reproduction", "performix"],
          "properties": {
            "adapter": {"const": "kleidiai-capacity-v1"},
            "root": {"type": "string", "minLength": 1},
            "checksums": {"type": "string", "minLength": 1},
            "workload_manifest": {"type": "string", "minLength": 1},
            "reproduction": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "checksums"],
              "properties": {
                "root": {"type": "string", "minLength": 1},
                "checksums": {"type": "string", "minLength": 1}
              }
            },
            "performix": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archive", "archive_sha256", "experiment_id", "disabled_run_id", "enabled_run_id", "linux_perf_kai_cycle_share", "maximum_share_difference"],
              "properties": {
                "archive": {"type": "string", "minLength": 1},
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "experiment_id": {"type": "string", "minLength": 1},
                "disabled_run_id": {"type": "string", "minLength": 1},
                "enabled_run_id": {"type": "string", "minLength": 1},
                "linux_perf_kai_cycle_share": {"type": "number", "minimum": 0, "maximum": 1},
                "maximum_share_difference": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "root", "checksums", "protocol"],
          "properties": {
            "adapter": {"const": "http-slo-v1"},
            "root": {"type": "string", "minLength": 1},
            "checksums": {"type": "string", "minLength": 1},
            "protocol": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "archive", "archive_sha256", "workload_manifest", "performix"],
          "properties": {
            "adapter": {"const": "kleidiai-sustained-v1"},
            "archive": {"type": "string", "minLength": 1},
            "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "workload_manifest": {"type": "string", "minLength": 1},
            "performix": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archive", "archive_sha256", "experiment_id", "disabled_run_id", "enabled_run_id", "linux_perf_kai_cycle_share", "maximum_share_difference"],
              "properties": {
                "archive": {"type": "string", "minLength": 1},
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "experiment_id": {"type": "string", "minLength": 1},
                "disabled_run_id": {"type": "string", "minLength": 1},
                "enabled_run_id": {"type": "string", "minLength": 1},
                "linux_perf_kai_cycle_share": {"type": "number", "minimum": 0, "maximum": 1},
                "maximum_share_difference": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "archive", "archive_sha256", "preregistration", "analysis_lock", "protocol_lock", "workload_manifest", "workload", "raw_quality", "performix", "memory_optimization"],
          "properties": {
            "adapter": {"const": "kleidiai-confirmed-v2"},
            "archive": {"type": "string", "minLength": 1},
            "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "preregistration": {"type": "string", "minLength": 1},
            "analysis_lock": {"type": "string", "minLength": 1},
            "protocol_lock": {"type": "string", "minLength": 1},
            "workload_manifest": {"type": "string", "minLength": 1},
            "workload": {"type": "string", "minLength": 1},
            "raw_quality": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "checksums", "ledger_sha256", "dataset"],
              "properties": {
                "root": {"type": "string", "minLength": 1},
                "checksums": {"type": "string", "minLength": 1},
                "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "dataset": {"type": "string", "minLength": 1}
              }
            },
            "performix": {
              "type": "object",
              "additionalProperties": false,
              "required": ["archive", "archive_sha256", "preregistration", "experiment_id", "disabled_run_id", "enabled_run_id"],
              "properties": {
                "archive": {"type": "string", "minLength": 1},
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "preregistration": {"type": "string", "minLength": 1},
                "experiment_id": {"type": "string", "minLength": 1},
                "disabled_run_id": {"type": "string", "minLength": 1},
                "enabled_run_id": {"type": "string", "minLength": 1}
              }
            },
            "memory_optimization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sustained_archive", "sustained_archive_sha256", "isolation_archive", "isolation_archive_sha256", "simplification_archive", "simplification_archive_sha256", "previous_capacity_rps", "expected_output_digest"],
              "properties": {
                "sustained_archive": {"type": "string", "minLength": 1},
                "sustained_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "isolation_archive": {"type": "string", "minLength": 1},
                "isolation_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "simplification_archive": {"type": "string", "minLength": 1},
                "simplification_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "previous_capacity_rps": {"type": "number", "exclusiveMinimum": 0},
                "expected_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": {
              "type": "string",
              "pattern": "^(?!(kleidiai-capacity-v1|kleidiai-sustained-v1|kleidiai-confirmed-v2|http-slo-v1)$).+"
            }
          }
        }
      ]
    },
    "deployment_summary": {"type": "string", "minLength": 1},
    "supporting_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "lock"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "lock": {"type": "string", "minLength": 1}
      }
    },
    "publication_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "project_bundle"],
      "properties": {
        "record": {"type": "string", "minLength": 1},
        "project_bundle": {"type": "string", "minLength": 1}
      }
    },
    "output": {"type": "string", "minLength": 1}
  }
}
