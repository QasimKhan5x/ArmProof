{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armproof.dev/schemas/contract.schema.json",
  "title": "ArmProof Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "treatments", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"type": "string", "minLength": 1},
    "treatments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "artifact_sha256", "runtime_sha256", "workload_sha256", "environment_sha256", "environment"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "workload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "causal_scope", "comparison_id", "metric", "operator", "threshold", "required_evidence", "required", "depends_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "causal_scope": {"enum": ["artifact", "arm_acceleration", "whole_deployment", "cloud_capacity", "overhead", "reproduction"]},
          "comparison_id": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "operator": {"enum": ["gte", "lte", "gt", "lt", "eq"]},
          "threshold": {"type": "number"},
          "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required": {"type": "boolean"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
